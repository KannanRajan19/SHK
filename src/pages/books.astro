---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import {
  sortBooks, paginate, formatRating, formatFinished, isInProgress, averageRating, PER_PAGE,
  filterBooks,
} from '../lib/books';
import type { Book } from '../lib/books';

// Collection order is insertion order, which is books.json order: newest first.
const books = (await getCollection('books')).map((b) => b.data) as Book[];

const sorted = sortBooks(books, 'date');
const firstPage = paginate(sorted, 1);
const avg = averageRating(books);
const finishedCount = books.filter((b) => !isInProgress(b)).length;
---

<Base title="book log · my little paper sky" page="reviews">
  <div class="page">
    <div class="section-label"><span>book log</span></div>

    <div class="head">
      <h2 class="title-serif" style="margin: 0;">everything i've read</h2>
      <div class="sorts">
        <button data-sort="date" class="on">date <span class="arrow" data-arrow>↓</span></button>
        <button data-sort="rating">rating <span class="arrow" data-arrow>↓</span></button>
        <button data-sort="author">author <span class="arrow" data-arrow>↑</span></button>
      </div>
    </div>

    <p class="intro">
      a ledger of books i've finished, with the date and a small thought.
      <span class="stats">
        {finishedCount} finished{avg !== null ? ` · avg ${avg.toFixed(1)}/5` : ''}
      </span>
    </p>

    <form class="search" role="search" data-search-form>
      <label class="sr-only" for="book-search">search the book log</label>
      <span class="search-mark" aria-hidden="true">⌕</span>
      <input
        id="book-search"
        type="search"
        data-search
        placeholder="look for a title or an author…"
        autocomplete="off"
      />
      <span class="search-count" data-search-result hidden></span>
      <button type="button" class="search-clear" data-search-clear hidden>clear</button>
    </form>

    <div class="booklog">
      <div class="booklog-head">
        <span>no.</span><span>title</span><span>author</span><span>finished</span><span>rating</span>
      </div>
      <ul data-rows>
        {firstPage.items.map((book, i) => (
          <li
            data-book-row
            data-edit="book"
            data-edit-id={String(i)}
            data-edit-title={book.title}
            data-edit-author={book.author}
            data-edit-finished={book.finished}
            data-edit-rating={String(book.rating)}
            data-edit-note={book.note}
          >
            <button class="bl-row" data-toggle>
              <span class="bl-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="bl-title" data-edit-slot="title">{book.title}</span>
              <span class="bl-author" data-edit-slot="author">{book.author}</span>
              <span class={`bl-finished${isInProgress(book) ? ' in-progress' : ''}`}>
                {formatFinished(book)}
              </span>
              <span class="bl-rating" data-edit-slot="ratingStars">{formatRating(book.rating)}</span>
            </button>
            {book.note && <div class="bl-note" hidden>{book.note}</div>}
          </li>
        ))}
      </ul>
    </div>

    <div class="pager" data-pager>
      <button data-first disabled>« first</button>
      <button data-prev disabled>← newer</button>
      <span>page <span data-page>1</span> of <span data-pages>{firstPage.pages}</span></span>
      <button data-next>older →</button>
      <button data-last>last »</button>
    </div>
  </div>

  {/*
    All 832 rows ship once as JSON (~20KB gzipped) and the island sorts and
    paginates in the browser. Statically generating every sort x page
    combination would be 126 HTML files for no benefit.
  */}
  <script type="application/json" id="book-data" set:html={JSON.stringify(books)} />
</Base>

<script>
  import {
    sortBooks, paginate, formatRating, formatFinished, isInProgress, PER_PAGE,
    filterBooks,
  } from '../lib/books';
  import type { Book, SortMode } from '../lib/books';

  const raw = document.getElementById('book-data')?.textContent;
  if (raw) {
    const books: Book[] = JSON.parse(raw);
    const rows = document.querySelector<HTMLElement>('[data-rows]')!;
    const pageEl = document.querySelector<HTMLElement>('[data-page]')!;
    const pagesEl = document.querySelector<HTMLElement>('[data-pages]')!;
    const first = document.querySelector<HTMLButtonElement>('[data-first]')!;
    const prev = document.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-next]')!;
    const last = document.querySelector<HTMLButtonElement>('[data-last]')!;
    const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sort]'));

    let mode: SortMode = 'date';
    // Each sort remembers its own direction, so switching away and back does
    // not silently reset what the reader chose.
    const directions: Record<SortMode, 'asc' | 'desc'> = {
      date: 'desc', rating: 'desc', author: 'asc',
    };
    let page = 1;
    let query = '';

    const searchEl = document.querySelector<HTMLInputElement>('[data-search]')!;
    const clearEl = document.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    const resultEl = document.querySelector<HTMLElement>('[data-search-result]')!;
    const pagerEl = document.querySelector<HTMLElement>('[data-pager]')!;

    // Also escapes quotes: these values now land in attributes as well as text.
    const esc = (s: string) =>
      String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    function render() {
      // Search narrows the log first; sorting and paging then apply to
      // whatever is left, so results stay sorted and never span stale pages.
      const matched = filterBooks(books, query);
      const sorted = sortBooks(matched, mode, directions[mode]);
      const view = paginate(sorted, page);
      page = view.page;

      const searching = query.trim() !== '';
      clearEl.hidden = !searching;
      resultEl.hidden = !searching;
      if (searching) {
        resultEl.textContent =
          matched.length === 0
            ? 'nothing found'
            : `${matched.length} ${matched.length === 1 ? 'book' : 'books'}`;
      }
      // A single page of results needs no pager.
      pagerEl.hidden = view.pages <= 1;

      rows.innerHTML = view.items
        .map((book, i) => {
          const n = String((view.page - 1) * PER_PAGE + i + 1).padStart(2, '0');
          const prog = isInProgress(book) ? ' in-progress' : '';
          const note = book.note
            ? `<div class="bl-note" hidden>${esc(book.note)}</div>`
            : '';
          return `<li data-book-row
            data-edit="book"
            data-edit-title="${esc(book.title)}"
            data-edit-author="${esc(book.author)}"
            data-edit-finished="${esc(book.finished)}"
            data-edit-rating="${book.rating}"
            data-edit-note="${esc(book.note)}"><button class="bl-row" data-toggle>
            <span class="bl-n">${n}</span>
            <span class="bl-title" data-edit-slot="title">${esc(book.title)}</span>
            <span class="bl-author" data-edit-slot="author">${esc(book.author)}</span>
            <span class="bl-finished${prog}">${esc(formatFinished(book))}</span>
            <span class="bl-rating" data-edit-slot="ratingStars">${formatRating(book.rating)}</span>
          </button>${note}</li>`;
        })
        .join('');

      // Rows are replaced wholesale, so any editing controls go with them.
      window.dispatchEvent(new CustomEvent('ps:rows-rendered'));
      pageEl.textContent = String(view.page);
      pagesEl.textContent = String(view.pages);
      first.disabled = view.page === 1;
      prev.disabled = view.page === 1;
      next.disabled = view.page === view.pages;
      last.disabled = view.page === view.pages;
    }

    const go = (n: number) => { page = n; render(); window.scrollTo({ top: 0 }); };
    first.addEventListener('click', () => go(1));
    prev.addEventListener('click', () => go(page - 1));
    next.addEventListener('click', () => go(page + 1));
    last.addEventListener('click', () => go(Number(pagesEl.textContent)));

    let debounce: number | undefined;
    searchEl.addEventListener('input', () => {
      // 832 rows re-render on every keystroke otherwise.
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => {
        query = searchEl.value;
        page = 1;
        render();
      }, 120);
    });

    // A search field's native clear button fires this rather than input.
    searchEl.addEventListener('search', () => {
      query = searchEl.value;
      page = 1;
      render();
    });

    clearEl.addEventListener('click', () => {
      searchEl.value = '';
      query = '';
      page = 1;
      render();
      searchEl.focus();
    });

    function paintArrows() {
      sortButtons.forEach((b) => {
        const m = b.dataset.sort as SortMode;
        const arrow = b.querySelector('[data-arrow]');
        if (arrow) arrow.textContent = directions[m] === 'asc' ? '↑' : '↓';
        b.classList.toggle('on', m === mode);
      });
    }

    sortButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const next = btn.dataset.sort as SortMode;
        // Clicking the sort already in use reverses it; that is how sortable
        // columns behave everywhere, and it saves a second control.
        if (next === mode) {
          directions[mode] = directions[mode] === 'asc' ? 'desc' : 'asc';
        } else {
          mode = next;
        }
        paintArrows();
        go(1);
      })
    );

    paintArrows();

    // One listener for every row, now and after each re-render.
    rows.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest('[data-toggle]');
      const note = button?.parentElement?.querySelector<HTMLElement>('.bl-note');
      if (note) note.hidden = !note.hidden;
    });

    render();
  }
</script>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .sorts {
    display: flex;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .sorts button {
    background: none;
    border: none;
    padding: 4px 8px;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--ink-faint);
    border-bottom: 1px solid transparent;
  }
  .sorts button.on { color: var(--accent); border-bottom-color: var(--accent); }
  .sorts .arrow { opacity: 0; margin-left: 2px; }
  .sorts button.on .arrow { opacity: 1; }
  .sorts button:hover .arrow { opacity: 0.5; }

  .intro { font-size: 15px; color: var(--ink-soft); max-width: 52ch; margin: 0 0 24px; }

  /* A ruled line to write on, rather than a box — it belongs on paper. */
  .search {
    display: flex;
    align-items: baseline;
    gap: 10px;
    max-width: 34rem;
    margin: 0 0 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--rule);
  }
  .search:focus-within { border-bottom-color: var(--accent); }
  .search-mark {
    font-size: 18px;
    line-height: 1;
    color: var(--ink-faint);
    transform: rotate(-8deg);
  }
  .search:focus-within .search-mark { color: var(--accent); }
  .search input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    background: transparent;
    border: none;
    outline: none;
    padding: 2px 0;
  }
  .search input::placeholder { color: var(--ink-faint); opacity: 0.8; }
  /* The stock webkit clear cross does not belong on a paper page. */
  .search input::-webkit-search-cancel-button { display: none; }
  /* Without a separator the count and the button read as one phrase:
     "9 books clear". */
  .search-count + .search-clear::before {
    content: '·';
    margin-right: 9px;
    opacity: 0.45;
  }
  .search-clear {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .search-clear:hover { color: var(--accent); }

  /* Count sits on the search line itself, where the reader is already looking. */
  .search-count {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .stats {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-left: 6px;
  }

  .search { margin-bottom: 26px; }

  .booklog-head,
  .booklog :global(.bl-row) {
    display: grid;
    grid-template-columns: 40px 1fr 1fr 110px 90px;
    gap: 18px;
    align-items: baseline;
  }
  .booklog-head {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .booklog :global(ul) { list-style: none; padding: 0; margin: 0; }
  .booklog :global(li) { border-bottom: 1px solid var(--rule); }
  .booklog :global(.bl-row) {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 14px 0;
    font-family: inherit;
    color: inherit;
  }
  .booklog :global(.bl-n) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.15em;
  }
  .booklog :global(.bl-title) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 19px;
    line-height: 1.2;
    color: var(--ink);
  }
  .booklog :global(.bl-author) { font-size: 14px; color: var(--ink-soft); }
  .booklog :global(.bl-finished) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .booklog :global(.bl-finished.in-progress) { color: var(--accent); }
  .booklog :global(.bl-rating) {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .booklog :global(.bl-note) {
    padding: 0 0 16px 58px;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 60ch;
  }

  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .pager button {
    background: none;
    border: 1px solid var(--rule);
    padding: 6px 12px;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--ink-soft);
  }
  .pager button:disabled { color: var(--rule); }

  @media (max-width: 700px) {
    .booklog-head :global(span):nth-child(3),
    .booklog :global(.bl-author) { display: none; }
    .booklog-head,
    .booklog :global(.bl-row) { grid-template-columns: 32px 1fr 96px 80px; }
  }
</style>
